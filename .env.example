# Java backend (set true when Spring Boot is running on port 8080)
# Start API with Neon: cd backend && .\run-neon.ps1
VITE_USE_JAVA_API=true

# API base URL when Java is enabled
VITE_API_BASE_URL=/api

# --- Spring Boot / Neon (see backend/.env.example) ---
# DATABASE_URL=jdbc:postgresql://...neon.tech/neondb?sslmode=require
# DATABASE_USERNAME=neondb_owner
# DATABASE_PASSWORD=
# TRACKER_DATABASE_URL=jdbc:postgresql://...neon.tech/neondb?sslmode=require
# JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
# STOREFRONT_URL=http://localhost:5173
# SPRING_PROFILES_ACTIVE=prod

# Bottom-right locale display
# VITE_SITE_CITY=Minneapolis
# VITE_SITE_COUNTRY=Minnesota
# VITE_SITE_TIMEZONE=America/Chicago
