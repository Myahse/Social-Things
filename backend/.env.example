# This storefront's Neon (orders, users)
DATABASE_URL=jdbc:postgresql://YOUR_HOST/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=
H2_CONSOLE_ENABLED=false
JPA_DDL_AUTO=update
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# tracker-social inventory Neon (catalog + stock)
TRACKER_DATABASE_URL=jdbc:postgresql://TRACKER_HOST/neondb?sslmode=require
TRACKER_DATABASE_USERNAME=neondb_owner
TRACKER_DATABASE_PASSWORD=
TRACKER_PUBLIC_BASE_URL=

STOREFRONT_URL=http://localhost:5173
# Tracker notifies catalog changes at ws://localhost:8080/api/ws/catalog

# Brevo transactional email (order confirmation). Never commit the real key.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contact@socialthngs.com
BREVO_SENDER_NAME=SOCIAL THINGS
# Optional Brevo dashboard template IDs (0 = use built-in SOCIAL THINGS HTML)
BREVO_TEMPLATE_WELCOME=0
BREVO_TEMPLATE_ORDER=0
BREVO_TEMPLATE_NEWSLETTER=0
# Optional Brevo Contacts list id for newsletter signups
BREVO_NEWSLETTER_LIST_ID=0
